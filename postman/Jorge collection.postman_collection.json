      "item": [
        {
          "name": "01 Create works (host)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"has id and title\", () => {",
                  "  pm.expect(body.id).to.be.a(\"number\");",
                  "  pm.expect(body.title).to.eql(\"Philippine Lit\");",
                  "});",
                  "pm.test(\"no extra fields leak\", () => pm.expect(Object.keys(body)).to.have.members([\"id\",\"title\",\"host_id\",\"created_at\"]));",
                  "pm.collectionVariables.set(\"setId\", body.id);",
                  "pm.collectionVariables.set(\"hostId\", body.host_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Demo-User",
                "value": "2099-0001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Philippine Lit\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
